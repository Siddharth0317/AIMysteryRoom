# AI Mystery Room — Backend Environment Configuration
# Copy this file to .env and provide your actual secrets

# Port for Express server
PORT=5000

# MongoDB Connection String (Atlas URI or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai_mystery_room

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
