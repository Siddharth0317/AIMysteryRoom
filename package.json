{
  "name": "ai-mystery-room",
  "version": "1.0.0",
  "description": "AI-powered mystery investigation game with a Cyberpunk / Sci-Fi Hacker Terminal UI",
  "private": true,
  "scripts": {
    "start": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "test:db": "npm --prefix server run test:db",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "install:all": "npm --prefix client install && npm --prefix server install"
  },
  "keywords": [
    "ai",
    "mystery",
    "game",
    "gemini",
    "cyberpunk",
    "react",
    "express"
  ],
  "author": "",
  "license": "MIT"
}
