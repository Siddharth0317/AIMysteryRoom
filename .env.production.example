# ==============================================================================
# AI Mystery Room — Production Environment Configuration Template
# ==============================================================================
# Use this template when deploying the backend and frontend to production hosts
# (e.g., Render, Railway, Vercel, MongoDB Atlas).
#
# IMPORTANT:
# - NEVER commit real keys or database credentials to version control.
# - Supply these variables in your hosting provider's Environment settings dashboard.
# ==============================================================================

# --- BACKEND ENVIRONMENT VARIABLES (e.g., Render / Railway / Heroku) ---
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection URI (Include database name, e.g. /ai_mystery_room)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/ai_mystery_room?retryWrites=true&w=majority

# Google Gemini API key (Secret — Backend only)
GEMINI_API_KEY=AIzaSy...

# Permitted Frontend Origin(s) for CORS. Can be comma-delimited for multiple domains.
# Example: https://ai-mystery-room.vercel.app,https://your-custom-domain.com
CLIENT_URL=https://<your-frontend-app>.vercel.app


# --- FRONTEND ENVIRONMENT VARIABLES (e.g., Vercel / Netlify) ---
# Public Base URL pointing to the deployed backend service (without trailing slash)
VITE_API_BASE_URL=https://<your-backend-app>.onrender.com
